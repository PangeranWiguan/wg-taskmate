# Ignore environment files
.env
.env.local

# Ignore IDE/editor-specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore logs and temporary files
logs/
*.log
*.tmp

# Ignore dependencies (if using Composer)
/vendor/

# Ignore uploaded files or media (if applicable)
uploads/
media/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore XAMPP-specific files (if applicable)
xampp/
htdocs/phpmyadmin/

# Ignore compiled or minified files (if applicable)
*.min.js
*.min.css

# Ignore database backups (if stored locally)
*.sql
*.bak